# Copy to backend/.env and adjust. backend/.env is git-ignored; never commit it.
# Nested settings use a double underscore: DESKPILOT_<ROLE>__<FIELD>.

DESKPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# PostgreSQL (started by docker compose). The password must match POSTGRES_PASSWORD
# in the repo-root .env. Host, port, database, and user default to the Compose setup.
DESKPILOT_DATABASE__PASSWORD=change-me

# Signing key for access tokens. Required; there is no default.
# Generate one with: openssl rand -hex 32
DESKPILOT_AUTH__JWT_SECRET=change-me

# Agent model. For fast iteration on graph logic, use qwen3:8b instead.
DESKPILOT_AGENT__PROVIDER=ollama
DESKPILOT_AGENT__MODEL=qwen3.6:35b
DESKPILOT_AGENT__NUM_CTX=32768

# Policy search. Embeddings always run on Ollama; Anthropic has no embeddings API.
# The prefixes are what nomic-embed-text expects. Changing the model, the prefix, or
# the dimensions marks the whole index stale, and dimensions also need a migration.
# DESKPILOT_EMBEDDINGS__MODEL=nomic-embed-text
# DESKPILOT_POLICY_SEARCH__TOP_K=4
# DESKPILOT_POLICY_SEARCH__MAX_DISTANCE=0.6

# Switching a role to Anthropic later needs the key plus both lines for that role:
# DESKPILOT_ANTHROPIC_API_KEY=sk-ant-...
# DESKPILOT_AGENT__PROVIDER=anthropic
# DESKPILOT_AGENT__MODEL=claude-sonnet-5
