# Copy to .env in the repo root. Used by Docker Compose only. Git-ignored; never commit it.
# Generate each secret with: openssl rand -hex 32

# ── PostgreSQL ────────────────────────────────────────────
# Must match DESKPILOT_DATABASE__PASSWORD in backend/.env.
POSTGRES_PASSWORD=change-me

# ── ShipTrack, the fake carrier ───────────────────────────
# The secret Deskpilot signs its requests with. Must match DESKPILOT_SHIPTRACK__SECRET
# in backend/.env. The only thing the two share, and they share it the way two
# companies would: out of band.
SHIPTRACK_SECRET=change-me

# Where the carrier calls back when a parcel moves, and the secret it signs those
# callbacks with. Deliberately a different secret from the one above: inbound and
# outbound are different directions, and one key for both means a leak costs twice.
# Must match DESKPILOT_SHIPTRACK__WEBHOOK_SECRET in backend/.env.
# On a Mac the carrier reaches the host API at host.docker.internal.
SHIPTRACK_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/shiptrack
SHIPTRACK_WEBHOOK_SECRET=change-me-too

# Make the carrier misbehave, to see what the client does about it.
# SHIPTRACK_LATENCY_MS=400
# SHIPTRACK_ERROR_RATE=0.2
# SHIPTRACK_HANG_RATE=0.1

# ── Paywisp, the fake payment processor ───────────────────
# The secret Deskpilot's agent authenticates to Paywisp's authorization server with.
# Paywisp only ever grants this client read access, whatever it asks for.
PAYWISP_AGENT_CLIENT_SECRET=change-me-three

# Optional. An EC P-256 private key in PEM form, so tokens survive a restart.
# Without one, Paywisp generates a key each time it starts.
# Generate one with: openssl ecparam -name prime256v1 -genkey -noout
# PAYWISP_SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----
# ...
# -----END EC PRIVATE KEY-----"
