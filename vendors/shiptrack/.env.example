# Copy to .env. Git-ignored; never commit it.
# The secret Deskpilot signs its requests with. Both sides need the same value,
# and it is the only thing the two systems share.
# Generate one with: openssl rand -hex 32
SHIPTRACK_SECRET=change-me

# Make the carrier behave like a real one. All off by default.
# SHIPTRACK_CHAOS__LATENCY_MS=400
# SHIPTRACK_CHAOS__ERROR_RATE=0.2
# SHIPTRACK_CHAOS__HANG_RATE=0.1
