# Copy to .env. Git-ignored; never commit it.

# The secret Deskpilot's agent authenticates with. Paywisp only ever grants this
# client read access, whatever it asks for.
# Generate one with: openssl rand -hex 32
PAYWISP_AUTH_AGENT_CLIENT_SECRET=change-me

# Optional. An EC P-256 private key in PEM form. Without one, a key is generated at
# startup and every token issued before a restart stops verifying.
# Generate one with: openssl ecparam -name prime256v1 -genkey -noout
# PAYWISP_AUTH_SIGNING_KEY="-----BEGIN EC PRIVATE KEY-----
# ...
# -----END EC PRIVATE KEY-----"
