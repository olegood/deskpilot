  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "category": {
            "anyOf": [
