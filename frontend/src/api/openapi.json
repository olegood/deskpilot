    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness only. Says nothing about the database on purpose: a health\nendpoint that reports which dependency is down tells an attacker too.",
        "operationId": "health_api_health_get",
        "responses": {
