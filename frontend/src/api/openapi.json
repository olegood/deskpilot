                "$ref": "#/components/schemas/TicketCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "escalated": {
            "type": "boolean",
            "title": "Escalated"
          }
        },
        "type": "object",
        "required": [
          "reference",
          "answer",
          "status",
          "category",
          "escalated"
        ],
        "title": "Answer",
        "description": "What one turn produced, for the caller that asked for it."
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "customer_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Email"
          }
        },
        "type": "object",
        "required": [
          "email",
          "role",
          "full_name",
          "customer_email"
        ],
        "title": "Identity"
      },
      "Message": {
        "properties": {
          "speaker": {
            "type": "string",
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "title": "Message"
      },
      "NewTicket": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject"
          },
          "message": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "message"
        ],
        "title": "NewTicket"
      },
      "Reply": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Reply"
      },
      "TicketCategory": {
        "type": "string",
        "enum": [
          "shipping",
          "return_or_refund",
          "warranty",
          "order_status",
          "product",
          "other"
        ],
        "title": "TicketCategory",
        "description": "What a ticket is about. Decided by the classifier, and only ever advisory."
      },
      "TicketDetail": {
        "properties": {
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TicketCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
